[
  {
    "id": "run-param-01",
    "description": "Set end time explicitly",
    "page_context": "run",
    "user_message": "Set the end time to 5",
    "fields_profile": "water_pipe",
    "expect": {
      "primary_intent": "parameter_configuration",
      "required_tags": [
        "UpdateInputs"
      ],
      "forbidden_tags": [
        "ViewerCmd"
      ],
      "update_inputs_contains": {
        "system/controlDict::endTime": "5"
      },
      "plain_text_non_empty": true
    },
    "expected_output": "UpdateInputs with system/controlDict::endTime set to 5.",
    "geval_criteria": "Response must use UpdateInputs to set end time to 5 and confirm in plain text."
  },
