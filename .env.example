# Optional overrides for docker compose (copy to .env)
# Do not commit real secrets.

# --- AI (Vertex / Gemini) ---
GOOGLE_CLOUD_PROJECT_ID=
# GEMINI_MODEL=gemini-2.5-flash
# Credentials: mount backend/credentials/key.json via compose (not an env value)

# --- Chatbot eval (DeepEval + pytest; host only — see scripts/run-chatbot-eval.sh) ---
# GOOGLE_APPLICATION_CREDENTIALS=backend/credentials/key.json
# FORGE_EVAL_JUDGE=0
# FORGE_EVAL_THRESHOLD=0.7
# OPENAI_API_KEY=   # required when FORGE_EVAL_JUDGE=1 (GEval judge LLM)

# --- Frontend build args (set in docker-compose.yml build section) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MONGODB_URI=mongodb://mongo:27017
# MONGODB_DB=forge_web

# --- Runner ---
# OPENFOAM_IMAGE=opencfd/openfoam-run:2512
# JOBS_VOLUME_NAME=forge-jobs-data

# --- OpenTelemetry (local Compose; SigNoz UI http://localhost:8080) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_PROPAGATORS=tracecontext,baggage
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# OTEL_SDK_DISABLED=true
# LOG_LEVEL=INFO

# --- HTTP response body preview in logs (dev; may contain PII) ---
# LOG_HTTP_BODY_ENABLED=true
# LOG_HTTP_BODY_MAX=1024
# Disable: LOG_HTTP_BODY_ENABLED=false or LOG_HTTP_BODY_MAX=0

# --- AWS dev (EC2 / CI — see deploy/aws/README.md) ---
# ECR_REGISTRY=
# DEV_PUBLIC_HOST=
