# Optional overrides for docker compose (copy to .env)
# Do not commit real secrets.

# --- AI (Vertex / Gemini) ---
GOOGLE_CLOUD_PROJECT_ID=
# GEMINI_MODEL=gemini-2.5-flash
# Credentials: mount ai/credentials/key.json via compose (not an env value)

# --- Frontend build args (set in docker-compose.yml build section) ---
# NEXT_PUBLIC_TRAME_VIEWER_URL=http://localhost:8090
# NEXT_PUBLIC_AI_WS_URL=ws://localhost:8081/ws

# --- Backend ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MONGODB_URI=mongodb://mongo:27017
# MONGODB_DB=openfoam_web

# --- Runner ---
# OPENFOAM_IMAGE=opencfd/openfoam-run:2512
# JOBS_VOLUME_NAME=openfoam-web-jobs-data

# --- AWS dev (EC2 / CI — see deploy/aws/README.md) ---
# ECR_REGISTRY=
# DEV_PUBLIC_HOST=
